# Database
DATABASE_URL=postgresql+asyncpg://smartcommerce:smartcommerce123@localhost:5432/smartcommerce
DATABASE_URL_SYNC=postgresql://smartcommerce:smartcommerce123@localhost:5432/smartcommerce

# Redis (optional; leave empty to use in-process cache and chat memory)
REDIS_URL=redis://localhost:6379

# Qdrant (":memory:" = in-process index rebuilt on startup; set QDRANT_API_KEY for Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini
GOOGLE_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# App
APP_NAME=SmartCommerce AI
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Demo hosting
# true = seed DB + build vector index on startup when they are empty
AUTO_BOOTSTRAP=false
# password given to the seeded "admin" user
ADMIN_PASSWORD=admin123
# chat caps: per user per hour, and for the whole app per day (0 disables)
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_DAILY_LIMIT=500
